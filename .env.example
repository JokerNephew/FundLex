# Reference only: secrets are injected into the process, never loaded from this file.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
FUNDLEX_AUTH_MODE=dev
# Legacy cost/request/call thresholds below are OBSERVATIONS only (FL-D445/FL-D449).
# Policy (2026-10-28): call real models as needed without cost/call approval; the
# usage ledger is recorded for traceability and never pauses a run by itself.
# Set a threshold to 0 (or leave empty) when no reference value is wanted. Values
# are reported in snapshots/metrics as "exceeded" but never reject or pause.
# For an explicit legacy hard-cap test only, set FUNDLEX_MODEL_ENFORCE_LIMITS=1;
# that switch requires positive thresholds and must never be enabled in production.
FUNDLEX_MODEL_MAX_REQUESTS=0
FUNDLEX_MODEL_MAX_COST_USD=0
FUNDLEX_MODEL_ENFORCE_LIMITS=0
# Preserve API concurrency, context/output capacity and finite technical retries.
FUNDLEX_MODEL_CONCURRENCY=1
FUNDLEX_MODEL_CONTEXT_CHARS=12000
FUNDLEX_MODEL_MAX_OUTPUT_TOKENS=1500
# Per-gateway logical-call reference for planning/observation; not a hard stop.
FUNDLEX_MODEL_MAX_CALLS=16
FUNDLEX_MODEL_TIMEOUT_S=45
FUNDLEX_MODEL_RETRIES=1
# Configure rates for the selected model; estimates are not provider invoices.
FUNDLEX_MODEL_INPUT_USD_PER_M=1
FUNDLEX_MODEL_OUTPUT_USD_PER_M=5
FUNDLEX_MODEL_REQUEST_OPTIONS_JSON={}
# Optional Langfuse tracing (observability only; off unless both keys are set).
FUNDLEX_LANGFUSE_PUBLIC_KEY=
FUNDLEX_LANGFUSE_SECRET_KEY=
FUNDLEX_LANGFUSE_HOST=https://cloud.langfuse.com
# 1 = send prompt/completion text; 0 = send only hashes and lengths.
FUNDLEX_LANGFUSE_CAPTURE_TEXT=1
# Feishu private-chat integration (production service only; inject secrets
# through the service environment or secret manager, never commit values).
FUNDLEX_FEISHU_APP_ID=
FUNDLEX_FEISHU_APP_SECRET=
FUNDLEX_PUBLIC_BASE_URL=
