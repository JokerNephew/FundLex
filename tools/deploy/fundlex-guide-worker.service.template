[Unit]
Description=FundLex regulation guide generation worker
After=network-online.target mysqld.service
Wants=network-online.target mysqld.service

[Service]
User=fundlex
Group=fundlex
WorkingDirectory=/opt/fundlex-recall-first
EnvironmentFile=/etc/fundlex-recall.env
# Guide generation is a long-running, model-heavy worker. It shares the API's
# database and object store but runs independently from the revision worker.
ExecStart=/opt/fundlex-recall-first/.venv/bin/python -X utf8 -m fundlex.guide_generation.worker
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fundlex
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
