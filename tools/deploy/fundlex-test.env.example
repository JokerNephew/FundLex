# FundLex isolated Test environment template.
# Copy to a root-owned file outside Git and inject secrets through your secret
# manager or systemd EnvironmentFile. Never commit the populated file.
FUNDLEX_ENV=test
FUNDLEX_COMMIT=unknown
FUNDLEX_DATA_DIR=/var/lib/fundlex-test
FUNDLEX_AUTH_MODE=password
FUNDLEX_AUTH_DATABASE=/var/lib/fundlex-test/auth.sqlite3
FUNDLEX_MODEL_LEDGER=/var/lib/fundlex-test/model_budget.sqlite
FUNDLEX_TRACE_JSONL=/var/lib/fundlex-test/traces/model-calls.jsonl
FUNDLEX_TRACE_CAPTURE_TEXT=0
FUNDLEX_LANGFUSE_CAPTURE_TEXT=0
FUNDLEX_ALLOW_REGISTRATION=0
FUNDLEX_SESSION_HOURS=12
FUNDLEX_WORKFLOW_CONCURRENCY=1
FUNDLEX_HEARTBEAT_MAX_AGE_S=30

# The Test environment must have its own provider project/key where possible.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
FUNDLEX_MODEL_MAX_REQUESTS=100
FUNDLEX_MODEL_MAX_CALLS=100
FUNDLEX_MODEL_MAX_COST_USD=1
FUNDLEX_MODEL_CONCURRENCY=1
FUNDLEX_MODEL_TIMEOUT_S=120
FUNDLEX_MODEL_RETRIES=1
FUNDLEX_MODEL_CONTEXT_CHARS=32000
FUNDLEX_MODEL_MAX_OUTPUT_TOKENS=4000
FUNDLEX_MODEL_INPUT_USD_PER_M=0.15
FUNDLEX_MODEL_OUTPUT_USD_PER_M=0.6
FUNDLEX_MODEL_REQUEST_OPTIONS_JSON={}
FUNDLEX_MODEL_EXTRA_HEADERS_JSON={}
