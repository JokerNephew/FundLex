[Unit]
Description=FundLex contract compare worker
After=network-online.target mysqld.service
Wants=network-online.target mysqld.service

[Service]
User=fundlex
Group=fundlex
WorkingDirectory=/opt/fundlex-recall-first
EnvironmentFile=/etc/fundlex-recall.env
# Install this unit only when the compare API is enabled.  It shares the API's
# FUNDLEX_DATA_DIR/FUNDLEX_DATABASE_URL and object store, but has an independent
# process so a compare failure cannot stop the revision worker.
ExecStart=/opt/fundlex-recall-first/.venv/bin/python -X utf8 -m fundlex.compare.worker
Restart=always
RestartSec=3

# Compare shares the API's database and object store, but its process is
# independently sandboxed. The deployment tree remains read-only; all
# uploaded inputs and generated compare results are under /var/lib/fundlex.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fundlex
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
