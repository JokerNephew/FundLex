+def _drawing_supported(node: etree._Element) -> bool:
+    tags = {child.tag for child in node.iter() if isinstance(child.tag, str)}
+    local_names = {etree.QName(tag).localname for tag in tags}
+    return f"{{{A}}}t" in tags and not local_names.intersection({"blip", "chart", "oleObj", "object"})
+
+
+def _pict_supported(node: etree._Element) -> bool:
+    local_names = {etree.QName(child).localname for child in node.iter() if isinstance(child.tag, str)}
+    return node.find(f".//{Q('t')}") is not None and "imagedata" not in local_names
+
