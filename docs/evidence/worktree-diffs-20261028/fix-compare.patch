+def _alternate_supported(node: etree._Element) -> bool:
+    choices = [child for child in node if child.tag == f"{{{MC}}}Choice"]
+    fallback = next((child for child in node if child.tag == f"{{{MC}}}Fallback"), None)
+    if not choices:
+        return fallback is not None
+    return fallback is not None and all(_text(choice) == _text(fallback) for choice in choices)
+
