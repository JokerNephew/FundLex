    {
      "rule_id": "R01",
      "action_id": "R01-A1",
      "description": "份额类别定义追加直销及持续持有费用规则",
      "section_anchor": "释义",
      "section_aliases": [],
      "subsection_anchor": "基金份额类别",
      "subsection_aliases": [],
      "regions": [
        "body",
        "summary"
      ],
      "scope": "paragraph",
      "operation": "append",
      "requires_profile": [
        "share_classes",
        "subscription_fee_by_class",
        "sales_service_fee_by_class"
      ],
      "condition": "fee_groups",
      "approval": {
        "auto_write": false,
        "approved": false,
        "status": "unreleased"
      },
      "semantics": {
        "subject": "投资者与基金管理人（直销机构）之间的费用豁免关系",
        "action": "在原份额类别定义段落之后追加直销机构费用豁免及持续持有超一年销售服务费停止收取条款",
        "condition": "仅当合同证据证明所有类别分别属于申购费组（收申购费、不计提销售服务费）或销售服务费组（不收申购费、计提销售服务费）时适用；存在混合类别或证据不足时拒绝",
        "fee_terms": "不新增具体费率、数字或比例；类别名称与费用归属只能来自当前合同证据",
        "ownership": "销售服务费仍归属基金资产；条款只涉及直销机构豁免及销售机构持续持有超一年后不再收取",
        "allowed_changes": [
          "在目标定义段落末尾追加一段新条款",
          "用当前合同实际类别替换参考文案中的 A/C 字样"
        ],
        "must_preserve": [
          "原份额类别定义段落逐字保留，不做任何删除或改写",
          "其他章节、编号、目录、表格与部件不得改动"
        ],
        "forbidden_additions": [
          "不得新增未经证据支持的费率、比例、期限或渠道条件",
          "不得把混合收费类别强行归入申购费组或销售服务费组",
          "不得按合同名称、文件名或样本编号选择类别"
        ],
        "unsupported": [
          "类别证据不足",
          "收费属性混合或未知",
          "目标段落存在结构屏障"
        ]
      },
      "locate": {
        "mode": "class_definition",
        "section": "class_definition",
        "require_class_letters_min": 2,
        "require_any": [
          "将基金份额分为",
          "分为不同的类别"
        ]
      },
      "generation": {
        "mode": "generate",
        "kind": "direct_sales_clause",
        "instruction": "以 REFERENCE_TEXT 为句式参考，为当前合同实际类别生成直销机构费用豁免及持续持有超一年服务费停止收取条款。必须使用 PROFILE_FACTS 中全部类别名称逐一点名，禁止使用不在当前合同类别集合中的类别字母；禁止新增费率、比例或数字；只生成要追加的条款正文，不得改写或重复原定义段落。source_quote 必须逐字等于 CONTRACT_SOURCE 内容。changes[].basis_requirement 只能使用 RULE_REQUIREMENTS 中列出的 id，或不提供该字段。",
        "reference_text": "投资者通过直销机构（含基金管理人及其销售子公司，下同）申购本基金A类基金份额时，不收取认购/申购费用；通过直销机构申购的C类基金份额，不收取销售服务费。对于投资者通过直销机构之外的其他销售机构申购的C类基金份额且持续持有期限超过一年的，不再继续收取销售服务费。",
        "max_chars": 400
      },
      "requirements": [
        {
          "id": "R01-REQ-1",
          "kind": "must_state",
          "text": "通过直销机构申购申购费组类别时不收取认购/申购费用，且逐一点名当前合同全部申购费组类别",
          "check": {
            "kind": "direct_sales_clause",
            "part": "subscription_group"
          },
          "verification": "code"
        },
        {
          "id": "R01-REQ-2",
          "kind": "must_state",
          "text": "通过直销机构申购销售服务费组类别时不收取销售服务费，且逐一点名当前合同全部销售服务费组类别",
          "check": {
            "kind": "direct_sales_clause",
            "part": "service_group"
          },
          "verification": "code"
        },
        {
          "id": "R01-REQ-3",
          "kind": "must_state",
          "text": "通过直销机构之外的其他销售机构申购销售服务费组类别且持续持有期限超过一年的，不再继续收取销售服务费",
          "check": {
            "kind": "direct_sales_clause",
            "part": "long_holding"
          },
          "verification": "code"
        },
        {
          "id": "R01-REQ-4",
          "kind": "must_not_state",
          "text": "不得出现合同类别之外的类别字母，不得出现具体费率数字",
          "check": {
            "kind": "classes_within_profile_and_no_digits"
          },
          "verification": "code"
        },
        {
          "id": "R01-REQ-5",
          "kind": "must_preserve",
          "text": "新文不得出现具体费率数字，除直销豁免与超过一年停止收取外不得设置其他条件",
          "check": {
            "kind": "semantic_review"
          },
          "verification": "model"
        }
      ],
      "model_verification": [
        "R01-REQ-5"
      ],
